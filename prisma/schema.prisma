// heekyo_blog — 데이터 모델
// provider를 postgresql로 바꾸면 Postgres로 이전할 수 있습니다(마이그레이션 재생성 필요).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────
// 인증 (Auth.js / 네이버 로그인)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // "ADMIN" = 글 쓸 수 있는 나, "USER" = 댓글/좋아요
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  posts    Post[]
  comments Comment[]
  likes    Like[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "naver"
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// 블로그
// ─────────────────────────────────────────────

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique // URL 주소: /posts/hello-world
  title       String
  content     String // Tiptap이 만든 HTML
  excerpt     String? // 목록에 보여줄 짧은 소개 (직접 작성)
  coverImage  String?
  category    String? // "daily" | "study" | "dev" — 목록은 src/lib/categories.ts 에서 관리
  published   Boolean   @default(false)
  publishedAt DateTime?
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // ── blot: AI 요약 캐시 ──
  // contentHash가 현재 본문의 해시와 다를 때만 API를 다시 호출합니다.
  summary       String?
  summaryModel  String? // 어떤 모델로 만들었는지 (모델 교체 시 재생성 판단용)
  summaryHash   String? // 요약을 만들 당시 본문의 해시
  summaryAt     DateTime?

  comments Comment[]
  likes    Like[]

  @@index([published, publishedAt])
  @@index([category, published])
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 실제로 지우지 않고 "삭제된 댓글입니다" 처리 (대댓글 보존용)

  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // 대댓글
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) // 한 사람이 한 글에 좋아요 한 번
  @@index([postId])
}

// 블로그 주인 소개. 한 줄만 존재하는 표라서 id를 "singleton"으로 고정합니다.
model Profile {
  id        String   @id @default("singleton")
  name      String   @default("")
  tagline   String   @default("") // 한 줄 소개
  bio       String   @default("") // 여러 줄 자기소개
  hobbies   String   @default("") // 쉼표로 구분 — SQLite에는 배열 타입이 없습니다
  avatarUrl String?

  // 지금 듣는 곡. 실제로 재생하지는 않고 무엇을 듣는지만 보여줍니다.
  musicTitle  String  @default("")
  musicArtist String  @default("")
  musicUrl    String? // 유튜브·스포티파이 등 들으러 갈 주소 (선택)
  updatedAt DateTime @updatedAt
}

// 홈 바탕화면에 주인이 직접 올려 둔 사진과 파일.
// x, y는 바탕화면 크기에 대한 비율(%)이라 창 크기가 달라져도 자리를 지킵니다.
model DesktopItem {
  id        String   @id @default(cuid())
  kind      String // "image" = 올린 사진, "note" = 이름만 있는 파일
  imageUrl  String? // kind가 image일 때의 사진 주소
  label     String   @default("") // 아이콘 아래 이름표
  x         Float
  y         Float
  rotate    Float    @default(0)
  createdAt DateTime @default(now())
}

// 바탕화면 아이콘을 주인이 끌어다 놓은 자리.
// 폴더·타일·글 파일처럼 원래 자리가 정해져 있는 아이콘만 여기에 기록합니다.
// (주인이 올린 사진·파일은 DesktopItem 자신이 x, y를 들고 있습니다.)
// key 예: "title", "folder:daily", "tile:blot", "post:비-오는-날의-기록"
model DesktopSpot {
  key       String   @id
  x         Float
  y         Float
  hidden    Boolean  @default(false) // 바탕화면에서 치운 아이콘
  updatedAt DateTime @updatedAt
}

// 바탕화면 꾸미기 (폴더 색 등). 한 줄만 있는 표입니다.
model DesktopSetting {
  id          String   @id @default("singleton")
  folderColor String   @default("blue") // src/lib/folder-colors.ts 의 이름
  updatedAt   DateTime @updatedAt
}
